---
import type { CollectionEntry } from 'astro:content';

interface Props {
  related: CollectionEntry<'tips'>[];
}

const { related } = Astro.props;
---
{related.length > 0 && (
  <nav class="related" aria-labelledby="related-heading">
    <h2 id="related-heading">関連する TIPS</h2>
    <ul>
      {related.map((t) => (
        <li>
          <a href={`/tips/${t.id}/`}>{t.data.title}</a>
          <p>{t.data.description}</p>
        </li>
      ))}
    </ul>
  </nav>
)}
