---
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const figures: Record<string, { src: string; alt: string; caption: string }[]> = {
  'japanese-fix': [
    {
      src: '/tips/fig-jp-paste.jpg',
      alt: '質問の前に貼る 3 行と、弱い例・足りる例',
      caption: '質問の前にこれを貼る。',
    },
  ],
  'three-entrances': [
    {
      src: '/tips/fig-entrances.jpg',
      alt: 'grok.com・公式アプリ・X で出るものが違う図',
      caption: '同じ Grok。入る場所で、出るものが違う。',
    },
  ],
  'free-vs-supergrok': [
    {
      src: '/tips/fig-bill-choose.jpg',
      alt: 'やりたいことから払う場所を決める図',
      caption: 'やりたいことから、払う場所を決める。',
    },
  ],
  'imagine-quickstart': [
    {
      src: '/tips/fig-imagine-formula.jpg',
      alt: '被写体、場面、画風の 3 つ',
      caption: '1 文は 3 つ。被写体、場面、画風。',
    },
  ],
  'imagine-video': [
    {
      src: '/tips/fig-imagine-video.jpg',
      alt: '先に絵。動きは一つ。動画は枠を多く使う',
      caption: '先に絵。動きは一つ。',
    },
  ],
  'bot-build-chat-map': [
    {
      src: '/tips/fig-bot.jpg',
      alt: 'チャット、Grok Bot、Grok Build は別の道具',
      caption: 'チャット、Bot、Build は別の道具。',
    },
  ],
};
const set = figures[slug] ?? [];
---
{set.map((fig) => (
  <figure class="article-hero">
    <img src={fig.src} alt={fig.alt} width="1280" height="720" />
    <figcaption>{fig.caption}</figcaption>
  </figure>
))}
