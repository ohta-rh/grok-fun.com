---
import HeroFigure from './HeroFigure.astro';

interface Props {
  slug: string;
}
const { slug } = Astro.props;

const figures: Record<string, { src: string; alt: string; caption: string }[]> = {
  'expert-and-heavy': [
    {
      src: '/tips/fig-expert-heavy.jpg',
      alt: 'ノートに、考えてほしい返事は Expert、極めて難しい問題は Heavy、月額は契約画面で見る、と書いてある',
      caption: '考えてほしい返事は Expert です。極めて難しい問題は Heavy で、月額は契約画面で見ます。',
    },
  ],
  'grok-automations': [
    {
      src: '/tips/fig-automations.jpg',
      alt: 'ノートに、時刻の予約は誰でも、メールで動かすなら SuperGrok、Grok Bot の定期実行とは別、と書いてある',
      caption: '時刻で回すなら誰でも使えます。メールが届いたら動かすなら SuperGrok です。',
    },
  ],
  'japanese-fix': [
    {
      src: '/tips/fig-jp-paste.jpg',
      alt: '「下の 3 行を貼る」と書いた紙。弱い例は「日本語で教えて」の 1 行だけ。足りる例は、すべて日本語で、英語の資料を貼っても日本語で、話題は ○○ だけ、と書いてある',
      caption: '下の 3 行をコピーして貼ります。「日本語で教えて」だけでは足りません。',
    },
  ],
  'three-entrances': [
    {
      src: '/tips/fig-entrances.jpg',
      alt: 'grok.com、公式アプリ、X の 3 つの入口を並べて、それぞれで出てくるものが違うことを示した図',
      caption: '同じ Grok でも、どこから入るかで出てくるメニューが違います。',
    },
  ],
  'free-vs-supergrok': [
    {
      src: '/tips/fig-bill-choose.jpg',
      alt: 'やりたいこと 4 つと、それぞれ払う場所を線で結んだ図。チャットと Imagine と Voice は grok.com の SuperGrok $30、X の中だけなら X Premium、Grok Bot だけなら Cursor Pro $20、自分のアプリから呼ぶなら console.x.ai',
      caption: '何をしたいかを先に決めると、払う場所が決まります。',
    },
  ],
  'imagine-quickstart': [
    {
      src: '/tips/fig-imagine-formula.jpg',
      alt: '被写体と場面と画風の 3 つを足して、1 文にする図',
      caption: '何を、どこで、どんな絵で、の 3 つを 1 文に書きます。',
    },
  ],
  'imagine-video': [
    {
      src: '/tips/fig-imagine-video.jpg',
      alt: '先に静止画を出して、動きを一つ書き足して、動画にする順番を示した図',
      caption: '先に絵を出して、動きは一つだけ書きます。',
    },
  ],
  'grok-bot-cloud-computer': [
    {
      src: '/tips/fig-grok-bot-diff.jpg',
      alt: 'チャットは会話が終わる。Grok Bot はコンピュータを持つ、と書いた図。チャットは grok.com の会話で切れたら終わり。Grok Bot はクラウドに自分用のコンピュータを持ち、アプリを閉じても仕事は続く。Grok Build はターミナルで動く',
      caption: 'チャットは会話が終われば終わりです。Grok Bot はクラウドにコンピュータを持ちます。Grok Build はターミナルです。',
    },
  ],
  'bot-uses-build': [
    {
      src: '/tips/fig-bot-uses-build.jpg',
      alt: '重い仕事は Grok Build に渡す、と書いた図。Grok Bot は会話を短くして、出てきたものを読む。Grok Build は調査も Imagine もやり、Bot のコンピュータで動く。出てきたものはそのまま使わない',
      caption: '調査も Imagine も、Bot のコンピュータに入れた Grok Build に渡します。出てきたものは、そのまま使いません。',
    },
  ],
  'grok-4-7': [
    {
      src: '/tips/fig-grok-4-7.jpg',
      alt: '横棒の図。上から Fable 5.1 が 53、Astra が 53、Opus 5 が 51、Grok 4.7 が 46 で短い。下に入力 $2、出力 $6。Fable は入力 $10、出力 $50',
      caption: '総合は Artificial Analysis の点です。Fable と Astra が上で、Grok 4.7 は 46 です。選ぶなら単価です。',
    },
  ],
  'bot-build-chat-map': [
    {
      src: '/tips/fig-bot.jpg',
      alt: 'チャット、Grok Bot、Grok Build を 3 つ並べて、それぞれ別の道具だと示した図',
      caption: 'チャットと Grok Bot と Grok Build は別の道具です。',
    },
  ],
};
const set = figures[slug] ?? [];
---
{set.map((fig, i) => (
  <HeroFigure src={fig.src} alt={fig.alt} caption={fig.caption} priority={i === 0} />
))}
