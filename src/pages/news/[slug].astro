---
import Base from '../../layouts/Base.astro';
import StaleBanner from '../../components/StaleBanner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ReactionBar from '../../components/ReactionBar.astro';
import CommentList from '../../components/CommentList.astro';
import Infographic from '../../components/Infographic.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const news = (await getCollection('news')).sort((a, b) => b.data.published.localeCompare(a.data.published));
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const url = `https://grok-fun.com/news/${entry.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': url,
      headline: entry.data.title,
      description: entry.data.description,
      inLanguage: 'ja',
      datePublished: `${entry.data.published}T00:00:00+09:00`,
      dateModified: `${entry.data.last_verified}T00:00:00+09:00`,
      mainEntityOfPage: url,
      author: {
        '@type': 'Organization',
        name: 'Grok JP（非公式ファンコミュニティ）',
        url: 'https://grok-fun.com/about/',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Grok JP（非公式ファンコミュニティ）',
        url: 'https://grok-fun.com/',
      },
      isBasedOn: entry.data.source_url,
      image: 'https://grok-fun.com/og-default.png',
      isPartOf: { '@type': 'WebSite', name: 'Grok JP', url: 'https://grok-fun.com/' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://grok-fun.com/' },
        { '@type': 'ListItem', position: 2, name: 'ニュース', item: 'https://grok-fun.com/news/' },
        { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
      ],
    },
  ],
};
---
<Base title={entry.data.title} description={entry.data.description} type="article" jsonLd={jsonLd}>
  <Breadcrumbs items={[
    { href: '/', label: 'ホーム' },
    { href: '/news/', label: 'ニュース' },
    { label: entry.data.title },
  ]} />
  <article>
    <p class="card-head">
      <span class="tag">発表</span>
      <span>発表日 <time datetime={entry.data.published}>{entry.data.published}</time></span>
      <span>最終確認 <time datetime={entry.data.last_verified}>{entry.data.last_verified}</time></span>
    </p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <Infographic slug={entry.id} />
    <StaleBanner lastVerified={entry.data.last_verified} />
    {toc.length >= 6 && (
      <details class="toc">
        <summary>このページの内容</summary>
        <ol>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </details>
    )}
    <Content />
    <aside class="sources">
      <h2>確かめるのに使った一次情報</h2>
      <ul>
        {entry.data.source_url.map((u) => <li><a href={u} rel="external noopener">{u}</a></li>)}
      </ul>
      <p>{entry.data.last_verified} に確かめました。点数も単価も変わります。数字は、リンク先のページで確かめてください。</p>
    </aside>
    <ReactionBar />
    <CommentList />
  </article>
  <script>
    import '../../scripts/widget';
    import '../../scripts/stale';
  </script>
</Base>
