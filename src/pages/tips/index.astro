---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const tips = (await getCollection('tips')).sort((a, b) => b.data.order - a.data.order);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://grok-fun.com/' },
    { '@type': 'ListItem', position: 2, name: 'TIPS', item: 'https://grok-fun.com/tips/' },
  ],
};
---
<Base title="TIPS" description="Grok を日本語で使うときの TIPS です。英語で返る、入口の違い、払う場所、Imagine、Grok Bot を、実際に試して日付と一次情報のリンクを付けています。記事の数は増やさず、戻ってきたときにここだけで足りるようにしています。新しいものから並んでいます。更新は RSS でも受け取れます。" jsonLd={jsonLd}>
  <Breadcrumbs items={[{ href: '/', label: 'ホーム' }, { label: 'TIPS' }]} />
  <p class="card-head"><span class="tag">series</span> <span>{tips.length} 本</span></p>
  <h1>TIPS</h1>
  <p class="lead">Grok を日本語で使うときの、短い実用メモです。新しいものから並べています。更新は <a href="/rss.xml">RSS</a> でも受け取れます。</p>
  <ol class="tips-list">
    {tips.map((t) => (
      <li>
        <span class="num">TIPS {String(t.data.order).padStart(2, '0')} · {t.data.product}</span><br />
        <a href={`/tips/${t.id}/`}>{t.data.title}</a>
        <p>{t.data.description}</p>
        <p class="meta">最終確認 <time datetime={t.data.last_verified}>{t.data.last_verified}</time></p>
      </li>
    ))}
  </ol>
</Base>
