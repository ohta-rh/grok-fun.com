---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { groupTips } from '../../lib/tip-groups';

const groups = groupTips(await getCollection('tips'));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://grok-fun.com/' },
    { '@type': 'ListItem', position: 2, name: 'TIPS', item: 'https://grok-fun.com/tips/' },
  ],
};
---
<Base title="TIPS" description="Grok を日本語で使うときの TIPS です。英語で返る、入口の違い、払う場所、Imagine、Grok Bot を、実際に試して日付と一次情報のリンクを付けています。製品ごとにまとめています。チャットだけ、読む順の一覧があります。更新は RSS でも受け取れます。" jsonLd={jsonLd}>
  <Breadcrumbs items={[{ href: '/', label: 'ホーム' }, { label: 'TIPS' }]} />
  <p class="card-head"><span class="tag">series</span> <span>{groups.reduce((n, g) => n + g.items.length, 0)} 本</span></p>
  <h1>TIPS</h1>
  <p class="lead">ここが全部の一覧です。ホームは、最初に読む 5 本だけを置いています。更新は <a href="/rss.xml">RSS</a> でも受け取れます。</p>
  {groups.map((g) => (
    <section>
      <h2>
        {g.product === 'chat'
          ? <a href="/tips/chat/">{g.label}</a>
          : g.label}（{g.items.length} 本）
      </h2>
      <ol class="tips-list">
        {g.items.map((t) => (
          <li>
            <span class="num">TIPS {String(t.data.order).padStart(2, '0')}</span><br />
            <a href={`/tips/${t.id}/`}>{t.data.title}</a>
            <p>{t.data.description}</p>
            <p class="meta">最終確認 <time datetime={t.data.last_verified}>{t.data.last_verified}</time></p>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
