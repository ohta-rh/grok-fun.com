---
import Base from '../../layouts/Base.astro';
import StaleBanner from '../../components/StaleBanner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTips from '../../components/RelatedTips.astro';
import ReactionBar from '../../components/ReactionBar.astro';
import CommentList from '../../components/CommentList.astro';
import Infographic from '../../components/Infographic.astro';
import HeroFigure from '../../components/HeroFigure.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const tips = (await getCollection('tips')).sort((a, b) => a.data.order - b.data.order);
  const byId = new Map(tips.map((t) => [t.id, t]));
  return tips.map((entry, i) => {
    for (const id of entry.data.related) {
      if (!byId.has(id)) throw new Error(`tips/${entry.id}: related の slug が見つかりません: ${id}`);
      if (id === entry.id) throw new Error(`tips/${entry.id}: related に自分自身は書けません`);
    }
    const related = entry.data.related
      .map((id) => byId.get(id))
      .filter((t): t is CollectionEntry<'tips'> => t !== undefined);
    return {
      params: { slug: entry.id },
      props: { entry, prev: tips[i - 1] ?? null, next: tips[i + 1] ?? null, related },
    };
  });
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const url = `https://grok-fun.com/tips/${entry.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': url,
      headline: entry.data.title,
      description: entry.data.description,
      inLanguage: 'ja',
      dateModified: entry.data.last_verified,
      mainEntityOfPage: url,
      author: { '@type': 'Organization', name: 'Grok JP（非公式ファンコミュニティ）' },
      publisher: { '@type': 'Organization', name: 'Grok JP（非公式ファンコミュニティ）' },
      isBasedOn: entry.data.source_url,
      image: `https://grok-fun.com${entry.data.image}`,
      isPartOf: { '@type': 'WebSite', name: 'Grok JP', url: 'https://grok-fun.com/' },
      mentions: related.map((t) => ({
        '@type': 'Article',
        headline: t.data.title,
        url: `https://grok-fun.com/tips/${t.id}/`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://grok-fun.com/' },
        { '@type': 'ListItem', position: 2, name: 'TIPS', item: 'https://grok-fun.com/tips/' },
        { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
      ],
    },
  ],
};
---
<Base title={entry.data.title} description={entry.data.description} type="article" jsonLd={jsonLd} image={entry.data.image}>
  <Breadcrumbs items={[
    { href: '/', label: 'ホーム' },
    { href: '/tips/', label: 'TIPS' },
    { label: entry.data.title },
  ]} />
  <article>
    <p class="card-head">
      <span class="tag">{entry.data.product}</span>
      <span>TIPS {String(entry.data.order).padStart(2, '0')}</span>
      <span>最終確認 <time datetime={entry.data.last_verified}>{entry.data.last_verified}</time></span>
    </p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <Infographic slug={entry.id} />
    {entry.id === 'imagine-quickstart' && (
      <HeroFigure src={entry.data.image} alt={entry.data.image_alt} caption={entry.data.image_caption} />
    )}
    <StaleBanner lastVerified={entry.data.last_verified} />
    {toc.length >= 6 && (
      <details class="toc">
        <summary>このページの内容</summary>
        <ol>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </details>
    )}
    <Content />
    <aside class="sources">
      <h2>確かめるのに使った一次情報</h2>
      {entry.data.source_url.length > 0 ? (
        <ul>
          {entry.data.source_url.map((u) => <li><a href={u} rel="external noopener">{u}</a></li>)}
        </ul>
      ) : (
        <p>一次情報の URL はありません。運営者が実際に操作して確かめました。</p>
      )}
      <p>{entry.data.last_verified} に確かめました。料金や制限や画面は変わります。数字は公式ページで確かめてください。</p>
    </aside>
    <RelatedTips related={related} />
    <ReactionBar />
    <CommentList />
  </article>
  <nav class="prev-next" aria-label="前後の TIPS">
    {prev ? (
      <a href={`/tips/${prev.id}/`}>
        <span class="prev-next-kicker">前の TIPS</span>
        <span class="prev-next-title">{prev.data.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a href={`/tips/${next.id}/`}>
        <span class="prev-next-kicker">次の TIPS</span>
        <span class="prev-next-title">{next.data.title}</span>
      </a>
    ) : <span></span>}
  </nav>
  <script>
    import '../../scripts/widget';
    import '../../scripts/copy';
    import '../../scripts/stale';
  </script>
</Base>
