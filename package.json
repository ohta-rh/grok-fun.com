{
  "name": "grok-fun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:worker": "wrangler types && tsc -p worker --noEmit",
    "build": "pnpm check:worker && astro check && astro build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply grok-fun-community --local",
    "d1:migrate:remote": "wrangler d1 migrations apply grok-fun-community --remote"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/biz-udpgothic": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.0",
    "wrangler": "^4.129.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
